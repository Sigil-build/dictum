<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A plugin under protocol 1 for the process tests: a small Kestrel app whose behaviour a JSON file sets
    (TestPluginBehaviour). A program the tests launch, not a test project, and never published.
  -->
  <PropertyGroup>
    <AssemblyName>dictum-test-plugin</AssemblyName>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Remove="xunit.v3" />
    <PackageReference Remove="Microsoft.Testing.Extensions.CodeCoverage" />
    <Using Remove="Xunit" />
  </ItemGroup>

</Project>
