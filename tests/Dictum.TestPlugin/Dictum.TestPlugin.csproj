<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A plugin under protocol 1 for the process tests: a small HTTP server on a socket (TestHttpServer) whose behaviour
    a JSON file sets (TestPluginBehaviour). Only the base framework, as a plugin's start is most of a plugin test. A
    program the tests launch, not a test project, and never published.
  -->
  <PropertyGroup>
    <AssemblyName>dictum-test-plugin</AssemblyName>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Remove="xunit.v3" />
    <PackageReference Remove="Microsoft.Testing.Extensions.CodeCoverage" />
    <Using Remove="Xunit" />
  </ItemGroup>

</Project>
