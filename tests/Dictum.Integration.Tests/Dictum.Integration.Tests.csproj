<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Integration tests are gated by DICTUM_INTEGRATION=1, so a run with zero tests (exit code 8) is expected. -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Dictum.Host/Dictum.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../fixtures/*.wav" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/*.json" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
