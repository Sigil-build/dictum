<Project Sdk="Microsoft.NET.Sdk">

  <!-- The fakes and helpers the test projects share: a library, not a test project. -->
  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit.v3 makes a project a test executable; this package is the part of it that holds TestContext. -->
    <PackageReference Remove="xunit.v3" />
    <PackageReference Remove="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Dictum.Audio/Dictum.Audio.csproj" />
    <ProjectReference Include="../../src/Dictum.Platform/Dictum.Platform.csproj" />
  </ItemGroup>

</Project>
