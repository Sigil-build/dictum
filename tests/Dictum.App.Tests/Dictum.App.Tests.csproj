<Project Sdk="Microsoft.NET.Sdk">

  <!-- Desktop app logic and views. UI code runs in Avalonia's headless platform with Skia, through AvaloniaFixture. -->
  <ItemGroup>
    <ProjectReference Include="../../src/Dictum.App/Dictum.App.csproj" />
    <ProjectReference Include="../Dictum.Testing/Dictum.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Dictum.Testing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>

  <ItemGroup>
    <!-- RealDaemonTests start the built dictum; nothing is referenced from it. -->
    <ProjectReference Include="../../src/Dictum.Cli/Dictum.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../fixtures/*.wav" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/frames-*.json" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
