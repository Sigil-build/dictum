<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <!-- Per user, no admin rights, into %LOCALAPPDATA%\Programs\Dictum (phase 4 spec 3.1). The UpgradeCode never changes. -->
  <Package Name="Dictum" Manufacturer="Dictum" Version="$(Version)" UpgradeCode="7F2C9E44-3B1A-4C6D-9E0F-5A8B2D1C4E37"
           Scope="perUser" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Dictum is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="dictum.ico" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="dictum.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Dictum" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(StageDir)\**" />
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="2B5D8F61-9C3E-4A7B-8D10-6E4F2A9C1B58">
      <Shortcut Id="DictumShortcut" Name="Dictum" Description="Voice to text" Target="[INSTALLFOLDER]dictum-gui.exe"
                WorkingDirectory="INSTALLFOLDER" Icon="dictum.ico" />
      <RegistryValue Root="HKCU" Key="Software\Dictum" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Before files are checked, replaced or removed, the installed copy quits a running Dictum (the GUI and its daemon).
         util:CloseApplication runs after RemoveFiles, too late for an uninstall. A first install has no file: ignored. -->
    <CustomAction Id="QuitDictum" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]dictum-gui.exe&quot; --quit"
                  Return="ignore" Impersonate="yes" />

    <!-- Uninstall (not an upgrade) removes the login item the app wrote, with the app's own code, while dictum.exe still exists. -->
    <SetProperty Id="RemoveLoginItem" Value="&quot;[INSTALLFOLDER]dictum.exe&quot; daemon --uninstall-autostart"
                 Before="RemoveLoginItem" Sequence="execute" />
    <CustomAction Id="RemoveLoginItem" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred"
                  Return="ignore" Impersonate="yes" />

    <!-- After an interactive install or upgrade, Dictum starts and its setup opens on first run. A silent install starts nothing. -->
    <CustomAction Id="LaunchDictum" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]dictum-gui.exe&quot;"
                  Return="asyncNoWait" Impersonate="yes" />

    <InstallExecuteSequence>
      <Custom Action="QuitDictum" Before="InstallValidate" Condition="Installed OR WIX_UPGRADE_DETECTED" />
      <Custom Action="RemoveLoginItem" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="LaunchDictum" After="InstallFinalize" Condition="NOT Installed AND UILevel &gt; 2" />
    </InstallExecuteSequence>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
