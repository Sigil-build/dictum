<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Dictum.App.Controls"
                    xmlns:res="using:Dictum.App.Resources">
  <!--
    The decorations Avalonia draws where a window's client area extends into its title bar: on Windows, minimise, maximise
    and close over Dictum's own 40 px title bar. Fluent's (Avalonia 12) has a full-screen button too, which Dictum hid with a
    style; Avalonia applied that style inside the button's first measure, so the button kept its 45 px, and the row's
    spacing, in the row's width, and Close stopped 47 px short of the window's right edge. These have no full-screen
    button, and Windows 11's measures: 46 px wide, touching, as tall as the title bar, Close in the top-right corner. As
    Windows' own, they are named in the UI's language, Restore when the window is maximised, and take no keyboard focus:
    Tab passes them by, and a click leaves the focus where it was.
  -->
  <!-- Background is the hover fill and BorderBrush the pressed fill; at rest the button is transparent. -->
  <ControlTheme x:Key="CaptionButton" TargetType="controls:CaptionButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="{DynamicResource color.caption.hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource color.caption.pressed}" />
    <Setter Property="Width" Value="46" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Background="Transparent" Content="{TemplateBinding Content}"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{TemplateBinding Background}" />
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{TemplateBinding BorderBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type WindowDrawnDecorations}" TargetType="WindowDrawnDecorations">
    <Setter Property="DefaultTitleBarHeight" Value="40" />
    <Setter Property="DefaultFrameThickness" Value="1" />
    <Setter Property="DefaultShadowThickness" Value="8" />
    <Setter Property="Template">
      <WindowDrawnDecorationsTemplate>
        <WindowDrawnDecorationsContent>
          <WindowDrawnDecorationsContent.Underlay>
            <Panel x:Name="PART_UnderlayWrapper">
              <Border x:Name="PART_WindowBorder" BorderThickness="{TemplateBinding FrameThickness}"
                      BorderBrush="{DynamicResource color.border.strong}" IsHitTestVisible="False" />
              <!-- The drag area behind the window's own title bar, which draws the icon and title over it. -->
              <Panel x:Name="PART_TitleBar" VerticalAlignment="Top" Height="{TemplateBinding TitleBarHeight}"
                     Background="Transparent" IsVisible="{TemplateBinding HasTitleBar}"
                     WindowDecorationProperties.ElementRole="TitleBar" />
            </Panel>
          </WindowDrawnDecorationsContent.Underlay>
          <WindowDrawnDecorationsContent.Overlay>
            <Panel x:Name="PART_OverlayWrapper">
              <StackPanel x:Name="PART_OverlayPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Height="{TemplateBinding TitleBarHeight}" IsVisible="{TemplateBinding HasTitleBar}">
                <controls:CaptionButton x:Name="PART_MinimizeButton" Theme="{StaticResource CaptionButton}"
                                        Caption="{x:Static res:Strings.CaptionMinimize}"
                                        WindowDecorationProperties.ElementRole="MinimizeButton">
                  <Viewbox Width="10">
                    <Path Stretch="UniformToFill" Data="M2048 1229v-205h-2048v205h2048z" />
                  </Viewbox>
                </controls:CaptionButton>
                <controls:CaptionButton x:Name="PART_MaximizeButton" Theme="{StaticResource CaptionButton}"
                                        Caption="{x:Static res:Strings.CaptionMaximize}"
                                        MaximizedCaption="{x:Static res:Strings.CaptionRestore}"
                                        WindowDecorationProperties.ElementRole="MaximizeButton">
                  <Viewbox Width="10">
                    <Path x:Name="RestoreButtonPath" Stretch="UniformToFill"
                          Data="M2048 2048v-2048h-2048v2048h2048zM1843 1843h-1638v-1638h1638v1638z" />
                  </Viewbox>
                </controls:CaptionButton>
                <controls:CaptionButton x:Name="PART_CloseButton" Theme="{StaticResource CaptionButton}" Background="#C42B1C"
                                        BorderBrush="#E6C42B1C" Caption="{x:Static res:Strings.CaptionClose}"
                                        WindowDecorationProperties.ElementRole="CloseButton">
                  <Viewbox Width="10">
                    <Path Stretch="UniformToFill"
                          Data="M1169 1024l879 -879l-145 -145l-879 879l-879 -879l-145 145l879 879l-879 879l145 145l879 -879l879 879l145 -145z" />
                  </Viewbox>
                </controls:CaptionButton>
              </StackPanel>
            </Panel>
          </WindowDrawnDecorationsContent.Overlay>
        </WindowDrawnDecorationsContent>
      </WindowDrawnDecorationsTemplate>
    </Setter>

    <Style Selector="^ /template/ Path">
      <Setter Property="Fill" Value="{DynamicResource color.text.primary}" />
    </Style>
    <Style Selector="^ /template/ controls|CaptionButton#PART_CloseButton:pointerover Path">
      <Setter Property="Fill" Value="White" />
    </Style>
    <Style Selector="^ /template/ controls|CaptionButton:disabled">
      <Setter Property="Opacity" Value="0.2" />
    </Style>
    <!-- Maximize is named Restore then. -->
    <Style Selector="^:maximized /template/ controls|CaptionButton">
      <Setter Property="IsWindowMaximized" Value="True" />
    </Style>
    <Style Selector="^:maximized /template/ Path#RestoreButtonPath">
      <Setter Property="Data"
              Value="M2048 410h-410v-410h-1638v1638h410v410h1638v-1638zM1434 1434h-1229v-1229h1229v1229zM1843 1843h-1229v-205h1024v-1024h205v1229z" />
    </Style>

    <!-- Where a platform has Avalonia draw the shadow and frame as well (Windows does not): inside them. -->
    <Style Selector="^:has-shadow /template/ Panel#PART_UnderlayWrapper">
      <Setter Property="Margin" Value="{TemplateBinding ShadowThickness}" />
    </Style>
    <Style Selector="^:has-shadow /template/ Border#PART_WindowBorder">
      <Setter Property="BoxShadow" Value="0 2 10 2 #80000000" />
    </Style>
    <Style Selector="^:has-shadow /template/ Panel#PART_OverlayWrapper">
      <Setter Property="Margin" Value="{TemplateBinding ShadowThickness}" />
    </Style>
    <Style Selector="^:has-border /template/ Panel#PART_TitleBar">
      <Setter Property="Margin" Value="1,1,1,0" />
    </Style>
    <Style Selector="^:has-border /template/ StackPanel#PART_OverlayPanel">
      <Setter Property="Margin" Value="0,1,1,0" />
    </Style>

    <!-- Where a platform does not allow an action. Windows allows them all, so no button is hidden during layout there. -->
    <Style Selector="^:not(:has-minimize) /template/ controls|CaptionButton#PART_MinimizeButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:not(:has-maximize) /template/ controls|CaptionButton#PART_MaximizeButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
