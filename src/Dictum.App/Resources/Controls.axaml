<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Dictum.App.Controls">
  <Styles.Resources>
    <ResourceDictionary>
      <!-- Row icons from the design (20 × 20, stroked 1.6 in text.secondary). -->
      <StreamGeometry x:Key="icon.login">M3,5.5 L17,5.5 M3,10 L17,10 M3,14.5 L11,14.5</StreamGeometry>
      <StreamGeometry x:Key="icon.microphone">M7,5 A3,3 0 0 1 13,5 L13,9 A3,3 0 0 1 7,9 Z M4.5,9.5 A5.5,5.5 0 0 0 15.5,9.5 M10,15 L10,18</StreamGeometry>
      <StreamGeometry x:Key="icon.sounds">M3,8 L3,12 L6,12 L10,15 L10,5 L6,8 Z M13,7.5 A3.5,3.5 0 0 1 13,12.5 M15.5,5 A7,7 0 0 1 15.5,15</StreamGeometry>
      <StreamGeometry x:Key="icon.history">M3,10 A7,7 0 1 0 17,10 A7,7 0 1 0 3,10 Z M10,6 L10,10 L12.5,11.5</StreamGeometry>
      <StreamGeometry x:Key="icon.language">M3,10 A7,7 0 1 0 17,10 A7,7 0 1 0 3,10 Z M3,10 L17,10 M10,3 C12.5,5.2 12.5,14.8 10,17 M10,3 C7.5,5.2 7.5,14.8 10,17</StreamGeometry>
      <StreamGeometry x:Key="icon.paste">M7,3.5 L13,3.5 L13,6 L7,6 Z M7,4.5 L5,4.5 L5,17 L15,17 L15,4.5 L13,4.5</StreamGeometry>
<StreamGeometry x:Key="icon.setup">M3,5 L5,7 L8,4 M10,5.5 L17,5.5 M3,10 L5,12 L8,9 M10,10.5 L17,10.5 M3,15 L5,17 L8,14 M10,15.5 L17,15.5</StreamGeometry>
      <StreamGeometry x:Key="icon.overlay">M5,4 L15,4 A2,2 0 0 1 17,6 L17,12 A2,2 0 0 1 15,14 L5,14 A2,2 0 0 1 3,12 L3,6 A2,2 0 0 1 5,4 Z M7,17 L13,17</StreamGeometry>

      <ControlTheme x:Key="{x:Type controls:SettingsRow}" TargetType="controls:SettingsRow">
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{DynamicResource color.bg.layer}" BorderBrush="{DynamicResource color.border}" BorderThickness="1"
                    CornerRadius="{DynamicResource radius.control}" Padding="16,12" MinHeight="{DynamicResource settingsRow.minHeight}">
              <StackPanel Spacing="12" VerticalAlignment="Center">
                <Grid ColumnDefinitions="20,16,*,16,Auto">
                  <Path Data="{TemplateBinding Icon}" Width="20" Height="20" VerticalAlignment="Center"
                        Stroke="{DynamicResource color.text.secondary}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" />
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{TemplateBinding Label}" TextWrapping="Wrap" Foreground="{DynamicResource color.text.primary}" />
                    <TextBlock Text="{TemplateBinding Description}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource color.text.secondary}"
                               IsVisible="{TemplateBinding Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{TemplateBinding Error}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource color.status.error.fg}"
                               IsVisible="{TemplateBinding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                  <ContentPresenter Grid.Column="4" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                </Grid>
                <ContentPresenter Content="{TemplateBinding Footer}" Margin="36,0,0,0"
                                  IsVisible="{TemplateBinding Footer, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Page titles: 28/36 600 (type.title). -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{DynamicResource type.title.size}" />
    <Setter Property="LineHeight" Value="{DynamicResource type.title.lineHeight}" />
    <Setter Property="FontWeight" Value="{DynamicResource type.title.weight}" />
    <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
  </Style>

  <!-- Buttons: primary = accent fill; destructive = the error text colour; link = text only. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource color.accent}" />
    <Setter Property="Foreground" Value="{DynamicResource color.text.onAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource color.accent.hover}" />
    <Setter Property="Foreground" Value="{DynamicResource color.text.onAccent}" />
  </Style>
  <Style Selector="Button.destructive">
    <Setter Property="Foreground" Value="{DynamicResource color.status.error.fg}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource color.text.secondary}" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
  </Style>

  <!-- Segmented control: joined 32 px items, the selected one in accent (design). -->
  <Style Selector="ListBox.segmented">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource color.border}" />
    <Setter Property="Background" Value="{DynamicResource color.bg.layer}" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:nth-child(1)">
    <Setter Property="CornerRadius" Value="4,0,0,4" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:nth-last-child(1)">
    <Setter Property="CornerRadius" Value="0,4,4,0" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource color.accent}" />
    <Setter Property="Foreground" Value="{DynamicResource color.text.onAccent}" />
  </Style>

  <!-- Warning banner (System summary, read-only pages). -->
  <Style Selector="Border.banner">
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="CornerRadius" Value="{DynamicResource radius.control}" />
    <Setter Property="Background" Value="{DynamicResource color.status.warn.bg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource color.status.warn.fg}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.banner TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource color.status.warn.fg}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- Hotkey recorder (design §4.13): keycaps; dashed accent while listening. -->
  <Style Selector="Button.hotkey">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.hotkey:recording /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource color.accent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource color.accent}" />
  </Style>
  <Style Selector="Ellipse.recordingDot">
    <Setter Property="Fill" Value="{DynamicResource color.accent}" />
  </Style>
  <Style Selector="Border.keycap">
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="CornerRadius" Value="{DynamicResource radius.control}" />
    <Setter Property="Background" Value="{DynamicResource color.bg.layer}" />
    <Setter Property="BorderBrush" Value="{DynamicResource color.border.strong}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
  </Style>
  <Style Selector="Border.keycap > TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
  </Style>
  <Style Selector="TextBlock.keycapPlus">
    <Setter Property="Foreground" Value="{DynamicResource color.text.secondary}" />
  </Style>
  <!-- Profiles editor rows (design §3.2): bordered, 140 px label column. -->
  <Style Selector="Border.editorRow">
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="CornerRadius" Value="{DynamicResource radius.control}" />
    <Setter Property="Background" Value="{DynamicResource color.bg.layer}" />
    <Setter Property="BorderBrush" Value="{DynamicResource color.border}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource color.text.secondary}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource color.status.error.fg}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource color.status.warn.fg}" />
  </Style>

  <!-- Chips (design §4.8): pills, a focusable × to remove; warned chips in the warning colours. -->
  <Style Selector="Border.chip">
    <Setter Property="Padding" Value="10,2,4,2" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource radius.chip}" />
    <Setter Property="Background" Value="{DynamicResource color.accent.subtleBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource color.accent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.chip > StackPanel > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource color.accent.subtleText}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip.warned">
    <Setter Property="Background" Value="{DynamicResource color.status.warn.bg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource color.status.warn.fg}" />
  </Style>
  <Style Selector="Border.chip.warned > StackPanel > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource color.status.warn.fg}" />
  </Style>
  <Style Selector="Button.chipRemove">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Content" Value="×" />
  </Style>

  <!-- Chain rows (design §3.2): 36 px, a dot handle; the dragged row gets the accent. -->
  <Style Selector="Border.chainRow">
    <Setter Property="Height" Value="36" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="CornerRadius" Value="{DynamicResource radius.control}" />
    <Setter Property="Background" Value="{DynamicResource color.bg.control}" />
    <Setter Property="BorderBrush" Value="{DynamicResource color.border}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.chainRow:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource color.accent}" />
  </Style>
  <Style Selector="Border.chainRow.dragged">
    <Setter Property="Background" Value="{DynamicResource color.accent.subtleBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource color.accent}" />
  </Style>
  <Style Selector="Border.handle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="SizeNorthSouth" />
  </Style>
  <!-- Models (design §3.5): cards with an accent border while downloading, pill badges, the download and disk bars. -->
  <Style Selector="Border.modelCard">
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="CornerRadius" Value="{DynamicResource radius.control}" />
    <Setter Property="Background" Value="{DynamicResource color.bg.layer}" />
    <Setter Property="BorderBrush" Value="{DynamicResource color.border}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.modelCard.active">
    <Setter Property="BorderBrush" Value="{DynamicResource color.accent}" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource color.bg.control}" />
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
  </Style>
  <Style Selector="Border.badge.info">
    <Setter Property="Background" Value="{DynamicResource color.accent.subtleBg}" />
  </Style>
  <Style Selector="Border.badge.info > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource color.accent.subtleText}" />
  </Style>
  <Style Selector="Border.badge.ok">
    <Setter Property="Background" Value="{DynamicResource color.status.ok.bg}" />
  </Style>
  <Style Selector="Border.badge.ok > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource color.status.ok.fg}" />
  </Style>
  <Style Selector="Border.badge.warn">
    <Setter Property="Background" Value="{DynamicResource color.status.warn.bg}" />
  </Style>
  <Style Selector="Border.badge.warn > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource color.status.warn.fg}" />
  </Style>
  <Style Selector="ProgressBar.download">
    <Setter Property="Height" Value="6" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Foreground" Value="{DynamicResource color.accent}" />
    <Setter Property="Background" Value="{DynamicResource color.border}" />
  </Style>
  <Style Selector="ProgressBar.disk">
    <Setter Property="Width" Value="220" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Height" Value="4" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Foreground" Value="{DynamicResource color.accent}" />
    <Setter Property="Background" Value="{DynamicResource color.border}" />
  </Style>
  <!-- Setup wizard (design Wizard): headings and leads, 36 px dialog buttons, the strip, pick rows and radio cards, the table, the 8 px total bar. -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="LineHeight" Value="32" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
  </Style>
  <Style Selector="TextBlock.lead">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource color.text.secondary}" />
  </Style>
  <Style Selector="TextBlock.ok">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource color.status.ok.fg}" />
  </Style>
  <Style Selector="Button.dialog">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.stripBar">
    <Setter Property="Height" Value="3" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource color.border}" />
  </Style>
  <Style Selector="Border.stripBar.on">
    <Setter Property="Background" Value="{DynamicResource color.accent}" />
  </Style>
  <Style Selector="Border.pickRow">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource radius.control}" />
    <Setter Property="Background" Value="{DynamicResource color.bg.layer}" />
    <Setter Property="BorderBrush" Value="{DynamicResource color.border}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.pickRow.card">
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.pickRow.on">
    <Setter Property="BorderBrush" Value="{DynamicResource color.accent}" />
  </Style>
  <Style Selector="Border.pickRow.disabled">
    <Setter Property="Background" Value="{DynamicResource color.bg.layerAlt}" />
  </Style>
  <Style Selector="ListBox.radioCards">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.radioCards ListBoxItem">
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="CornerRadius" Value="{DynamicResource radius.control}" />
    <Setter Property="Background" Value="{DynamicResource color.bg.layer}" />
    <Setter Property="BorderBrush" Value="{DynamicResource color.border}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ListBox.radioCards ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource color.bg.controlHover}" />
  </Style>
  <Style Selector="ListBox.radioCards ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource color.bg.layer}" />
    <Setter Property="BorderBrush" Value="{DynamicResource color.accent}" />
  </Style>
  <Style Selector="Ellipse.radio">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stroke" Value="{DynamicResource color.text.secondary}" />
    <Setter Property="StrokeThickness" Value="1.5" />
  </Style>
  <Style Selector="ListBox.radioCards ListBoxItem:selected Ellipse.radio">
    <Setter Property="Stroke" Value="{DynamicResource color.accent}" />
    <Setter Property="StrokeThickness" Value="5" />
  </Style>
  <Style Selector="Border.table">
    <Setter Property="CornerRadius" Value="{DynamicResource radius.control}" />
    <Setter Property="BorderBrush" Value="{DynamicResource color.border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.tableHead">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="{DynamicResource color.bg.layer}" />
  </Style>
  <Style Selector="Border.tableHead TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource color.text.secondary}" />
  </Style>
  <Style Selector="Border.tableRow">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="BorderBrush" Value="{DynamicResource color.border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.totalRow">
    <Setter Property="Padding" Value="0,10,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource color.border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="ProgressBar.total">
    <Setter Property="Height" Value="8" />
    <Setter Property="MinHeight" Value="8" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource color.accent}" />
    <Setter Property="Background" Value="{DynamicResource color.border}" />
  </Style>
</Styles>
