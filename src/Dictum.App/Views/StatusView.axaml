<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dictum.App.ViewModels"
             xmlns:res="using:Dictum.App.Resources"
             x:Class="Dictum.App.Views.StatusView"
             x:DataType="vm:StatusViewModel">
  <StackPanel Margin="16" Spacing="{DynamicResource space.3}">
    <TextBlock Text="{Binding Headline}" TextWrapping="Wrap"
               FontSize="{DynamicResource type.subtitle.size}" FontWeight="{DynamicResource type.subtitle.weight}"
               Foreground="{DynamicResource color.text.primary}" />
    <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" Foreground="{DynamicResource color.status.error.fg}"
               IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <Button Content="{x:Static res:Strings.StatusRestartButton}" Command="{Binding RestartCommand}" IsVisible="{Binding CanRestart}" />
    <TextBlock Text="{x:Static res:Strings.StatusNoTray}" TextWrapping="Wrap" Foreground="{DynamicResource color.status.warn.fg}"
               IsVisible="{Binding NoTray}" />
    <ItemsControl ItemsSource="{Binding Profiles}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <TextBlock Text="{Binding}" Foreground="{DynamicResource color.text.primary}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <!-- Selectable to copy a path, so no breaks go into the text: a path too long for the line wraps onto its own. -->
    <SelectableTextBlock Text="{Binding ConfigLine}" TextWrapping="Wrap" Foreground="{DynamicResource color.text.secondary}" />
    <SelectableTextBlock Text="{Binding LogLine}" TextWrapping="Wrap" Foreground="{DynamicResource color.text.secondary}" />
  </StackPanel>
</UserControl>
