<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dictum.App.ViewModels.Settings"
             xmlns:settings="using:Dictum.App.Settings"
             xmlns:controls="using:Dictum.App.Controls"
             xmlns:res="using:Dictum.App.Resources"
             xmlns:views="using:Dictum.App.Views.Settings"
             x:Class="Dictum.App.Views.Settings.SystemView"
             x:DataType="vm:SystemPage">
  <ScrollViewer>
    <StackPanel Margin="16,4,32,20" Spacing="16">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Classes="title" Text="{Binding Title}" />
        <TextBlock Grid.Column="1" Text="{Binding Header}" FontSize="12" Margin="16,0" VerticalAlignment="Bottom"
                   HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Foreground="{DynamicResource color.text.secondary}" />
        <Button Grid.Column="2" Content="{x:Static res:Strings.SettingsSystemCheckAgain}" VerticalAlignment="Bottom"
                Command="{Binding CheckAgainCommand}" />
      </Grid>

      <Border Classes="card">
        <ContentControl Content="{Binding Service}" />
      </Border>

      <Border Classes="banner" IsVisible="{Binding HasProblems}">
        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
      </Border>
      <TextBlock Text="{Binding Summary}" IsVisible="{Binding !HasProblems}" Foreground="{DynamicResource color.text.secondary}" />

      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="settings:SystemRow">
            <Border Classes="card" Padding="16,8" Margin="0,0,0,6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{StaticResource settings.badge.width}" />
                  <ColumnDefinition Width="200" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:StatusBadge Level="{Binding Level}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Grid.ColumnSpan="{Binding Detail, Converter={x:Static views:SystemView.StatusSpan}}" Margin="14,0"
                            VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource color.text.primary}" />
                  <TextBlock Text="{Binding Status, Converter={x:Static views:SystemView.Breakable}}" FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource color.text.secondary}" />
                  <!-- The troubleshooting section for the check, in the browser; its accessible name names the row. -->
                  <Button Classes="link" Content="{x:Static res:Strings.SettingsSystemHelp}" Command="{Binding Help}" FontSize="12"
                          Margin="0,2,0,0" HorizontalAlignment="Left" AutomationProperties.Name="{Binding HelpName}"
                          IsVisible="{Binding Help, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Detail, Converter={x:Static views:SystemView.Breakable}}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource color.text.primary}"
                           IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Button Grid.Column="3" Classes="primary" Margin="14,0,0,0" VerticalAlignment="Center"
                        Content="{Binding FixLabel}" Command="{Binding Fix}"
                        IsVisible="{Binding FixLabel, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{x:Static res:Strings.SettingsSystemFooter}" FontSize="12" TextWrapping="Wrap"
                 Foreground="{DynamicResource color.text.secondary}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
