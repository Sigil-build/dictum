<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dictum.App.ViewModels.Settings"
             xmlns:res="using:Dictum.App.Resources"
             xmlns:views="using:Dictum.App.Views.Settings"
             xmlns:controls="using:Dictum.App.Controls"
             x:Class="Dictum.App.Views.Settings.ProcessorsView"
             x:DataType="vm:ProcessorsPage">
  <Grid Margin="{StaticResource settings.listPage.margin}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{StaticResource settings.listPage.listWidth}" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Classes="title" Text="{Binding Title}" Margin="0,0,0,8" />
      <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,4,0,0" IsEnabled="{Binding CanEdit}">
        <Button Content="{x:Static res:Strings.SettingsProcessorsAddLlm}" HorizontalAlignment="Stretch" Command="{Binding AddLlmCommand}" />
        <Button Content="{x:Static res:Strings.SettingsProcessorsAddRules}" HorizontalAlignment="Stretch" Command="{Binding AddRulesCommand}" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Processors}" SelectedItem="{Binding Selected}" Background="Transparent"
               AutomationProperties.Name="{x:Static res:Strings.SettingsProcessors}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ProcessorItem">
            <StackPanel Spacing="2" Margin="0,4">
              <TextBlock Text="{Binding Id}" FontWeight="SemiBold" Foreground="{DynamicResource color.text.primary}" />
              <TextBlock Text="{Binding Caption}" Classes="hint" />
              <TextBlock Text="{x:Static res:Strings.SettingsProcessorsInNoProfile}" Classes="warning" IsVisible="{Binding InNoProfile}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <ScrollViewer Grid.Column="2" IsVisible="{Binding HasProcessor}">
      <StackPanel Spacing="10" Margin="{StaticResource settings.listPage.editorMargin}" IsEnabled="{Binding CanEdit}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="{Binding Selected.Id}" FontWeight="SemiBold" Foreground="{DynamicResource color.text.primary}" />
            <TextBlock Text="{Binding UsedBy}" Classes="hint" IsVisible="{Binding UsedBy, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="destructive" Content="{x:Static res:Strings.SettingsProcessorsRemove}" Command="{Binding RemoveCommand}" />
        </Grid>
        <!-- The picker stays outside the banner, whose text colour would reach the dropdown's items. -->
        <StackPanel Spacing="6" IsVisible="{Binding NoChainWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Border Classes="banner">
            <TextBlock Text="{Binding NoChainWarning}" />
          </Border>
          <ComboBox x:Name="AddToPicker" Classes="picker" Width="260" ItemsSource="{Binding AddToChoices}" SelectedItem="{Binding AddTo}"
                    IsVisible="{Binding HasAddTo}" PlaceholderText="{x:Static res:Strings.SettingsProcessorsAddTo}"
                    AutomationProperties.Name="{x:Static res:Strings.SettingsProcessorsAddTo}" />
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding IsLlm}">
          <Border Classes="editorRow">
            <controls:FormColumns>
              <StackPanel Spacing="4">
                <TextBlock Text="{x:Static res:Strings.SettingsProvidersUrl}" Classes="hint" />
                <TextBox x:Name="UrlBox" Text="{Binding Llm.Url}" AutomationProperties.Name="{x:Static res:Strings.SettingsProvidersUrl}" />
                <TextBlock Text="{Binding Llm.UrlError}" Classes="error" IsVisible="{Binding Llm.UrlError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="{x:Static res:Strings.SettingsProvidersModel}" Classes="hint" />
                <TextBox Text="{Binding Llm.Model}" AutomationProperties.Name="{x:Static res:Strings.SettingsProvidersModel}" />
                <TextBlock Text="{Binding Llm.ModelError}" Classes="error" IsVisible="{Binding Llm.ModelError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
              <views:ApiKeyRow DataContext="{Binding Llm.Key}" />
              <StackPanel Spacing="4">
                <TextBlock Text="{x:Static res:Strings.SettingsProvidersTimeout}" Classes="hint" />
                <NumericUpDown Value="{Binding Llm.TimeoutSeconds}" Minimum="1" Maximum="600" Increment="1" FormatString="0" Width="120"
                               HorizontalAlignment="Left" AutomationProperties.Name="{x:Static res:Strings.SettingsProvidersTimeout}" />
                <TextBlock Text="{Binding Llm.TimeoutError}" Classes="error" IsVisible="{Binding Llm.TimeoutError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="{x:Static res:Strings.SettingsLlmTemperature}" Classes="hint" />
                <NumericUpDown Value="{Binding Llm.Temperature}" Minimum="0" Maximum="{x:Static vm:LlmEditor.MaxTemperature}" Increment="0.1" FormatString="0.0" Width="120"
                               HorizontalAlignment="Left" AutomationProperties.Name="{x:Static res:Strings.SettingsLlmTemperature}" />
                <TextBlock Text="{Binding Llm.TemperatureError}" Classes="error" IsVisible="{Binding Llm.TemperatureError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="{x:Static res:Strings.SettingsLlmMaxTokens}" Classes="hint" />
                <NumericUpDown Value="{Binding Llm.MaxTokens}" Minimum="1" Maximum="32000" Increment="64" FormatString="0" Width="120"
                               HorizontalAlignment="Left" AutomationProperties.Name="{x:Static res:Strings.SettingsLlmMaxTokens}" />
                <TextBlock Text="{Binding Llm.MaxTokensError}" Classes="error" IsVisible="{Binding Llm.MaxTokensError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="{x:Static res:Strings.SettingsLlmOnError}" Classes="hint" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Llm.ErrorModes}" SelectedItem="{Binding Llm.OnError}"
                          AutomationProperties.Name="{x:Static res:Strings.SettingsLlmOnError}" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="{x:Static res:Strings.SettingsLlmWording}" Classes="hint" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Llm.Wordings}" SelectedItem="{Binding Llm.Wording}"
                          AutomationProperties.Name="{x:Static res:Strings.SettingsLlmWording}" />
              </StackPanel>
            </controls:FormColumns>
          </Border>

          <Border Classes="editorRow">
            <StackPanel Spacing="8">
              <WrapPanel ItemSpacing="12" LineSpacing="8">
                <TextBlock Text="{x:Static res:Strings.SettingsLlmPrompt}" VerticalAlignment="Center" />
                <ComboBox Width="260" ItemsSource="{Binding Llm.Prompt.Names}" SelectedItem="{Binding Llm.Prompt.Selected}"
                          AutomationProperties.Name="{x:Static res:Strings.SettingsLlmPrompt}" />
                <Button Classes="link" Content="{x:Static res:Strings.SettingsLlmRestorePrompt}" Command="{Binding Llm.Prompt.RestoreCommand}"
                        VerticalAlignment="Center" />
              </WrapPanel>
              <TextBlock Text="{Binding Llm.Prompt.Note}" Classes="hint" />
              <TextBlock Text="{Binding Llm.Prompt.Shared}" Classes="hint" TextWrapping="Wrap"
                         IsVisible="{Binding Llm.Prompt.Shared, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBox x:Name="PromptBox" Text="{Binding Llm.Prompt.Text}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160"
                       FontFamily="{DynamicResource font.family.mono}" AutomationProperties.Name="{x:Static res:Strings.SettingsLlmPrompt}" />
              <TextBlock Text="{Binding Llm.Prompt.Error}" Classes="error" IsVisible="{Binding Llm.Prompt.Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <TextBox Width="220" Text="{Binding Llm.Prompt.NewName}" PlaceholderText="{x:Static res:Strings.SettingsLlmNewPrompt}"
                         AutomationProperties.Name="{x:Static res:Strings.SettingsLlmNewPrompt}" />
                <Button Content="{x:Static res:Strings.SettingsLlmCreatePrompt}" Command="{Binding Llm.Prompt.CreateCommand}" />
              </WrapPanel>
              <TextBlock Text="{Binding Llm.Prompt.NewNameError}" Classes="error" IsVisible="{Binding Llm.Prompt.NewNameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Border>

          <Border Classes="editorRow">
            <StackPanel Spacing="8">
              <WrapPanel ItemSpacing="12" LineSpacing="8">
                <TextBlock Text="{x:Static res:Strings.SettingsLlmPreview}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ListBox Classes="segmented" ItemsSource="{Binding Llm.Preview.Languages}" SelectedItem="{Binding Llm.Preview.SampleLanguage}"
                         AutomationProperties.Name="{x:Static res:Strings.SettingsLlmSample}" />
                <Button Content="{x:Static res:Strings.SettingsLlmPreviewNow}" Command="{Binding Llm.Preview.RunCommand}" />
              </WrapPanel>
              <TextBox Text="{Binding Llm.Preview.SampleText}" TextWrapping="Wrap" AutomationProperties.Name="{x:Static res:Strings.SettingsLlmSample}" />
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding Llm.Preview.Running}" Height="2" />
              <SelectableTextBlock Text="{Binding Llm.Preview.Text}" TextWrapping="Wrap" Foreground="{DynamicResource color.text.primary}" />
              <TextBlock Text="{Binding Llm.Preview.Latency}" Classes="hint" />
              <TextBlock Text="{Binding Llm.Preview.Error}" Classes="error" IsVisible="{Binding Llm.Preview.Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Classes="editorRow" IsVisible="{Binding IsRules}">
          <StackPanel Spacing="6">
            <TextBlock Text="{x:Static res:Strings.SettingsRulesHint}" Classes="hint" />
            <Grid ColumnDefinitions="*,8,*,8,32">
              <TextBlock Text="{x:Static res:Strings.SettingsRulesFind}" Classes="hint" />
              <TextBlock Grid.Column="2" Text="{x:Static res:Strings.SettingsRulesReplace}" Classes="hint" />
            </Grid>
            <ItemsControl x:Name="RuleList" ItemsSource="{Binding Rules.Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RuleRow">
                  <StackPanel Spacing="2" Margin="0,0,0,8">
                    <!-- Tab follows the children: the boxes, the options under them, then × at the first line's end. -->
                    <Grid ColumnDefinitions="*,8,*,8,32" RowDefinitions="Auto,2,Auto">
                      <TextBox Classes="ruleFind" Text="{Binding Find}" AutomationProperties.Name="{x:Static res:Strings.SettingsRulesFind}" />
                      <TextBox Grid.Column="2" Text="{Binding Replace}" AutomationProperties.Name="{x:Static res:Strings.SettingsRulesReplace}" />
                      <WrapPanel Grid.Row="2" Grid.ColumnSpan="5" ItemSpacing="16" TextElement.FontSize="12">
                        <CheckBox IsChecked="{Binding IsRegex}" Content="{x:Static res:Strings.SettingsRulesRegex}"
                                  AutomationProperties.Name="{x:Static res:Strings.SettingsRulesRegex}" />
                        <CheckBox IsChecked="{Binding MatchCase}" Content="{x:Static res:Strings.SettingsRulesMatchCase}"
                                  AutomationProperties.Name="{x:Static res:Strings.SettingsRulesMatchCase}" />
                        <CheckBox IsChecked="{Binding WholeWord}" IsEnabled="{Binding CanWholeWord}" Content="{x:Static res:Strings.SettingsRulesWholeWord}"
                                  AutomationProperties.Name="{x:Static res:Strings.SettingsRulesWholeWord}" />
                        <CheckBox IsChecked="{Binding On}" Content="{x:Static res:Strings.CommonOn}" AutomationProperties.Name="{x:Static res:Strings.CommonOn}" />
                      </WrapPanel>
                      <Button Grid.Column="4" Classes="chipRemove" Command="{Binding RemoveCommand}" IsVisible="{Binding !IsDraft}"
                              AutomationProperties.Name="{x:Static res:Strings.SettingsRemove}" />
                    </Grid>
                    <TextBlock Text="{Binding Error}" Classes="error" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="ImportButton" Content="{x:Static res:Strings.SettingsRulesImport}" />
              <TextBlock Text="{Binding Rules.ImportNote}" Classes="hint" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
