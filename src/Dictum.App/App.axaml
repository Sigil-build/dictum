<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Dictum.App"
             x:Class="Dictum.App.App"
             RequestedThemeVariant="Default">
  <Application.DataTemplates>
    <app:ViewLocator />
  </Application.DataTemplates>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Resources/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Drawn caption buttons for windows with a custom 40 px title bar. -->
      <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="Transparent" />
      <x:Double x:Key="CaptionButtonHeight">40</x:Double>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Resources/Controls.axaml" />
    <Style Selector="WindowDrawnDecorations:has-titlebar /template/ Panel#PART_TitleTextPanel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </Application.Styles>
</Application>
