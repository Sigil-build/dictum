<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ApplicationIcon>$(MSBuildThisFileDirectory)..\..\packaging\icons\dictum.ico</ApplicationIcon>
    <OutputType>Exe</OutputType>
    <AssemblyName>dictum</AssemblyName>
    <RootNamespace>Dictum.Cli</RootNamespace>
    <PublishAot>true</PublishAot>
    <!-- Culture data is needed for Ukrainian. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Dictum.Host/Dictum.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dictum.Cli.Tests" />
  </ItemGroup>

</Project>
