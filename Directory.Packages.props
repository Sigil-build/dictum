<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup Label="Host and CLI">
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Audio">
    <!-- Native PortAudio builds from the sherpa-onnx project; bindings are our own. -->
    <PackageVersion Include="org.k2fsa.portaudio.runtime.linux-x64" Version="1.0.6" />
    <PackageVersion Include="org.k2fsa.portaudio.runtime.win-x64" Version="1.0.6" />
    <PackageVersion Include="org.k2fsa.portaudio.runtime.osx-arm64" Version="1.0.6" />
    <PackageVersion Include="org.k2fsa.portaudio.runtime.osx-x64" Version="1.0.6" />
  </ItemGroup>

  <ItemGroup Label="Speech and platform">
    <PackageVersion Include="Whisper.net" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
    <PackageVersion Include="SharpHook" Version="8.0.0" />
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup Label="Packaging">
    <PackageVersion Include="WixToolset.Util.wixext" Version="6.0.1" />
  </ItemGroup>
</Project>
